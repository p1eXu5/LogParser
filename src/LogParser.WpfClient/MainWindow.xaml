<Window x:Class="LogParser.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mainModel="clr-namespace:LogParser.ElmishApp.MainModel;assembly=LogParser.ElmishApp"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sel="clr-namespace:LogParser.WpfClient.TemplateSelectors"
        xmlns:uc="clr-namespace:LogParser.WpfClient.UserControls"
        Title="{Binding Title}"
        Width="1000"
        d:DataContext="{d:DesignInstance Type=mainModel:IBindings,
                                         IsDesignTimeCreatable=False}"
        d:Height="200"
        AllowDrop="True"
        Background="{StaticResource br_WindiwBackground}"
        Drop="Window_Drop"
        Icon=".\Resources\gnomelogs_103380.ico"
        Style="{StaticResource MaterialDesignWindow}"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        >
    <Window.Resources>
        <sel:LogDataTemplateSelector x:Key="ts_LogDataTemplateSelector" />
    </Window.Resources>

    <materialDesign:DialogHost x:Name="m_RootDialogHost"
                               CloseOnClickAway="False"
                               DialogTheme="Inherit"
                               Identifier="RootDialog"
                               SnackbarMessageQueue="{Binding ElementName=m_ErrorMessageQueueSnackbar,
                                                              Path=MessageQueue}"
                               >
        <DockPanel LastChildFill="True">
            <!--  MainMenu  -->
            <uc:MainMenuBar DockPanel.Dock="Top"
                            Margin="2,0,2,0"
                            />

            <!--  ToolBar  -->
            <uc:LogParserToolBarTray DockPanel.Dock="Top"
                                     DataContext="{Binding LogFileList.SelectedLogFile}"
                                     RawLogsToggler="{Binding ElementName=m_LogFileList,
                                                              Path=RawLogsInputVisibility,
                                                              Converter={StaticResource conv_VisibleToBoolean},
                                                              Mode=OneWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                     />

            <!--  ErrorMessage Snackbar  -->
            <materialDesign:Snackbar x:Name="m_ErrorMessageQueueSnackbar"
                                     DockPanel.Dock="Bottom"
                                     HorizontalAlignment="Stretch"
                                     MessageQueue="{Binding ErrorMessageQueue}"
                                     />

            <!--  Status Bar  -->
            <uc:StatusBar DockPanel.Dock="Bottom" VerticalAlignment="Bottom" />

            <!--  Content  -->
            <uc:LogFileList x:Name="m_LogFileList"
                            Margin="2,0,2,2"
                            DataContext="{Binding LogFileList}"
                            />
        </DockPanel>
    </materialDesign:DialogHost>
</Window>
