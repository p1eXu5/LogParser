<ToolBar x:Class="LogParser.WpfClient.UserControls.ToolBars.FiltersToolBar"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:local="clr-namespace:LogParser.WpfClient.UserControls.ToolBars"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         d:DesignWidth="1350"
         Style="{StaticResource st_LogParserToolBar}"
         mc:Ignorable="d"
         >
    <!--  Log filters  -->
    <ListBox VerticalAlignment="Center"
             SelectionMode="Extended"
             >
        <!--  FilterOn switcher - IsSelected="{Binding FilterOn}"  -->
        <ListBoxItem IsSelected="False"
                     Style="{DynamicResource st_ToolBarListBoxItem}"
                     ToolTip="Enable filtering by TraceId"
                     >
            <materialDesign:PackIcon Height="18"
                                     Kind="Filter"
                                     />
        </ListBoxItem>

        <!--  ShowInnerHierarchyLogs switcher - IsSelected="{Binding ShowInnerHierarchyLogs}"  -->
        <ListBoxItem IsSelected="False"
                     Style="{DynamicResource st_ToolBarListBoxItem}"
                     ToolTip="When disabled only root logs are shown"
                     >
            <materialDesign:PackIcon Height="18"
                                     Kind="FileTree"
                                     />
        </ListBoxItem>
    </ListBox>

    <!--  OrderByTimestampCommand - Command="{Binding OrderByTimestampCommand}  -->
    <ToggleButton Padding="10,0"
                  Style="{StaticResource st_ToolBarIconToggleButton}"
                  >
        <materialDesign:PackIcon Height="22"
                                 Kind="SortClockAscendingOutline"
                                 />
    </ToggleButton>

    <TextBlock Style="{StaticResource st_ToolBarTextBlock}"
               Text="From:  "
               />

    <!--  Start date time - DateTime="{Binding Start}"  -->
    <local:ToolBarDateTimePicker />

    <TextBlock Style="{StaticResource st_ToolBarTextBlock}"
               Text="To:  "
               />

    <!--  End date time - DateTime="{Binding End}"  -->
    <local:ToolBarDateTimePicker VerticalAlignment="Center" />

    <!--  LogLevels items source - ItemsSource="{Binding LogLevels}", Text="{Binding SelectedLogLevel, UpdateSourceTrigger=PropertyChanged, Mode=OneWayToSource}"  -->
    <ComboBox materialDesign:HintAssist.Hint="Log Level"
              IsEditable="True"
              IsTextSearchEnabled="True"
              Style="{StaticResource st_ToolBarComboBox}"
              />

    <!--  ServiceNames items source -  ItemsSource="{Binding ServiceNames}", Text="{Binding SelectedServiceName, UpdateSourceTrigger=PropertyChanged, Mode=OneWayToSource}"  -->
    <ComboBox materialDesign:HintAssist.Hint="Service name"
              IsEditable="True"
              IsTextSearchEnabled="True"
              Style="{StaticResource st_ToolBarComboBox}"
              />

</ToolBar>
