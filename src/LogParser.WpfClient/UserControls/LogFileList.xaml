<UserControl x:Class="LogParser.WpfClient.UserControls.LogFileList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:LogFileListModel="clr-namespace:LogParser.ElmishApp.LogFileListModel;assembly=LogParser.ElmishApp"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LogParser.WpfClient.UserControls"
             xmlns:logFileModel="clr-namespace:LogParser.ElmishApp.LogFileModel;assembly=LogParser.ElmishApp"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:Background="{StaticResource br_WindiwBackground}"
             d:DataContext="{d:DesignInstance Type=LogFileListModel:IBindings,
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="150"
             d:DesignWidth="800"
             mc:Ignorable="d"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="st_TabRadioButton"
                   BasedOn="{StaticResource st_MaterialDesignTabRadioButtonDerived}"
                   TargetType="RadioButton"
                   >
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="13" />
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="False">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.ToolBar.Background}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="dt_LogFileItemTemplate"
                          DataType="{x:Type logFileModel:IBindings}"
                          >
                <RadioButton IsChecked="{Binding IsSelected}"
                             Style="{StaticResource st_TabRadioButton}"
                             >
                    <TextBlock Text="{Binding FileName}" />
                </RadioButton>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <materialDesign:ColorZone DockPanel.Dock="Top"
                                  Background="Transparent"
                                  Mode="Standard"
                                  >
            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          >
                <StackPanel Orientation="Horizontal">

                    <ItemsControl x:Name="m_Tabs"
                                  ItemTemplate="{StaticResource dt_LogFileItemTemplate}"
                                  ItemsSource="{Binding LogFileList.LogFiles}"
                                  >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!--  StackPanel as the items host  -->
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <RadioButton x:Name="m_AddNewTab"
                                 Style="{StaticResource st_TabRadioButton}"
                                 >
                        <Behaviors:Interaction.Triggers>
                            <Behaviors:EventTrigger EventName="Click"
                                                    SourceObject="{Binding ElementName=m_AddNewTab}"
                                                    >
                                <Behaviors:InvokeCommandAction Command="{Binding AddNewLogFileCommand}" />
                            </Behaviors:EventTrigger>
                        </Behaviors:Interaction.Triggers>
                        <TextBlock Text="Add New" />
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>

            
            
            <!--<StackPanel DockPanel.Dock="Top"
