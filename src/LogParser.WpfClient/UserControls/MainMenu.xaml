<Menu x:Class="LogParser.WpfClient.UserControls.MainMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:LogParser.WpfClient.UserControls"
      xmlns:mainModel="clr-namespace:LogParser.ElmishApp.MainModel;assembly=LogParser.ElmishApp"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      x:Name="m_MainMenu"
      Height="32"
      Margin="0,2,0,0"
      Padding="0"
      VerticalAlignment="Center"
      VerticalContentAlignment="Center"
      d:DataContext="{d:DesignInstance Type=mainModel:IBindings,
                                       IsDesignTimeCreatable=False}"
      d:DesignHeight="32"
      d:DesignWidth="500"
      IsMainMenu="True"
      Style="{StaticResource MaterialDesignMenu}"
      mc:Ignorable="d"
      >

    <Menu.Resources>
        <Style BasedOn="{StaticResource MaterialDesignMenuItem}"
               TargetType="MenuItem"
               >
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Light" />
        </Style>
    </Menu.Resources>

    <MenuItem Height="{Binding ElementName=m_MainMenu,
                               Path=ActualHeight}"
              VerticalAlignment="Bottom"
              VerticalContentAlignment="Bottom"
              Header="_File"
              >
        <MenuItem Command="{Binding NewFileCommand}"
                  Header="New"
                  Icon="{materialDesign:PackIcon Kind=OpenInApp}"
                  InputGestureText="Ctrl+O"
                  />

        <MenuItem Command="{Binding OpenLogsFileCommand}"
                  Header="Open..."
                  Icon="{materialDesign:PackIcon Kind=OpenInApp}"
                  InputGestureText="Ctrl+O"
                  />

        <MenuItem Command="{Binding SaveLogsFileCommand}"
                  Header="Save"
                  Icon="{materialDesign:PackIcon Kind=ContentSave}"
                  InputGestureText="Ctrl+S"
                  />

        <MenuItem Command="{Binding SaveLogsFileAsCommand}"
                  Header="Save As.."
                  Icon="{materialDesign:PackIcon Kind=ContentSave}"
                  />
    </MenuItem>
</Menu>
