<ToolBar x:Class="LogParser.WpfClient.UserControls.ToolBars.StandardToolBar"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:local="clr-namespace:LogParser.WpfClient.UserControls.ToolBars"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         x:Name="m_StandardToolBarRoot"
         d:DesignWidth="700"
         ClipToBounds="True"
         Style="{StaticResource st_LogParserToolBar}"
         mc:Ignorable="d"
         >
    <Button Command="{Binding PasteFromClipboardCommand}"
            Style="{StaticResource st_ToolBarIconButton}"
            >
        <materialDesign:PackIcon Height="16"
                                 Kind="ContentCopy"
                                 />
    </Button>

    <Button Command="{Binding ClearInputCommand}"
            Style="{StaticResource st_ToolBarIconButton}"
            >
        <materialDesign:PackIcon Height="20"
                                 Kind="DeleteOutline"
                                 />
    </Button>

    <ListBox VerticalAlignment="Center"
             SelectionMode="Extended"
             >
        <ListBoxItem x:Name="m_RawLogsToggler"
                     IsSelected="{Binding ElementName=m_StandardToolBarRoot,
                                          Path=RawLogsToggler}"
                     Style="{DynamicResource st_ToolBarListBoxItem}"
                     >
            <!--  or FileDocumentCheckOutline when document is edited  -->
            <materialDesign:PackIcon Width="18"
                                     Height="18"
                                     Kind="FileDocumentEdit"
                                     />
        </ListBoxItem>
    </ListBox>

    <TextBlock Style="{StaticResource st_ToolBarTextBlock}"
               Text="Tmp Title:"
               />

    <TextBox Width="120"
             materialDesign:HintAssist.Hint="Temp Title"
             Style="{StaticResource st_ToolBarTextBox}"
             Text="{Binding TempTitle,
                            UpdateSourceTrigger=PropertyChanged}"
             />

    <TextBlock Style="{StaticResource st_ToolBarTextBlock}"
               Text="Log Source Type:"
               />

    <!--  Service name  -->
    <ComboBox Width="130"
              materialDesign:HintAssist.Hint="Log Source Type"
              IsEditable="True"
              IsTextSearchEnabled="True"
              ItemsSource="{Binding LogSourceType}"
              Style="{StaticResource st_ToolBarComboBox}"
              Text="{Binding LogSourceType,
                             UpdateSourceTrigger=PropertyChanged,
                             Mode=OneWayToSource}"
              />
</ToolBar>
