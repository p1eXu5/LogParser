<UserControl x:Class="LogParser.WpfClient.UserControls.MainContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LogParser.WpfClient.UserControls"
             xmlns:logFileModel="clr-namespace:LogParser.ElmishApp.LogFileModel;assembly=LogParser.ElmishApp"
             xmlns:mainModel="clr-namespace:LogParser.ElmishApp.MainModel;assembly=LogParser.ElmishApp"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:Background="{StaticResource br_WindiwBackground}"
             d:DataContext="{d:DesignInstance Type=mainModel:IBindings,
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="150"
             d:DesignWidth="800"
             mc:Ignorable="d"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="st_TabRadioButton"
                   BasedOn="{StaticResource st_MaterialDesignTabRadioButtonDerived}"
                   TargetType="RadioButton"
                   >
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="13" />
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="False">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.ToolBar.Background}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="dt_LogFileItemTemplate"
                          DataType="{x:Type logFileModel:IBindings}"
                          >
                <RadioButton IsChecked="{Binding IsSelected}"
                             Style="{StaticResource st_TabRadioButton}"
                             >
                    <TextBlock Text="{Binding FileName}" />
                </RadioButton>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <materialDesign:ColorZone DockPanel.Dock="Top"
                                  Background="Transparent"
                                  Mode="Standard"
                                  >
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          >

                <ItemsControl ItemTemplate="{StaticResource dt_LogFileItemTemplate}"
                              ItemsSource="{Binding LogFileList.LogFiles}"
                              >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!--  StackPanel as the items host  -->
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

            </ScrollViewer>
            <!--<StackPanel DockPanel.Dock="Top"
                        Margin="0"
                        Orientation="Horizontal"
                        >
                <RadioButton Style="{StaticResource st_TabRadioButton}"
                             IsChecked="False"
                             >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="4,0,0,0"
                                   Text="First document document"
                                   />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource st_TabRadioButton}"
                             IsChecked="True"
                             >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="4,0,0,0"
                                   Text="Second document"
                                   />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource st_TabRadioButton}"
                             IsChecked="False"
                             >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="4,0,0,0"
                                   Text="First document document"
                                   />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource st_TabRadioButton}"
                             IsChecked="False"
                             >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="4,0,0,0"
                                   Text="First document document"
                                   />
                    </StackPanel>
                </RadioButton>
            </StackPanel>-->
        </materialDesign:ColorZone>
        <Border />
    </DockPanel>
</UserControl>
