<UserControl x:Class="LogParser.WpfClient.UserControls.LogFileContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LogParser.WpfClient.UserControls"
             xmlns:mainModel="clr-namespace:LogParser.ElmishApp.MainModel;assembly=LogParser.ElmishApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=mainModel:IBindings,
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d"
             >
    <Grid>
        <!--  split view  -->
        <Grid Visibility="{Binding ShowAll, Converter={StaticResource conv_BoolToVis}, FallbackValue=Visible}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition MinWidth="500" />
            </Grid.ColumnDefinitions>

            <!--  LogsInput  -->
            <local:LogsInput DataContext="{Binding}" />

            <!--  Splitter  -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource br_ToolBarInput}"
                          />

            <!--  Logs  -->
            <local:LogCardList Grid.Column="2"
                               DataContext="{Binding}"
                               />
        </Grid>

        <!--  only log cards view  -->
        <local:LogCardList DataContext="{Binding}"
                           Visibility="{Binding ShowOnlyParsedLogs,
                                                Converter={StaticResource conv_BoolToVis},
                                                FallbackValue=Collapsed}"
                           />
    </Grid>
</UserControl>
