<UserControl x:Class="LogParser.WpfClient.UserControls.LogParserToolBarTray"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:LogFileModel="clr-namespace:LogParser.ElmishApp.LogFileModel;assembly=LogParser.ElmishApp"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LogParser.WpfClient.UserControls.ToolBars"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LogParser.ElmishApp.Models;assembly=LogParser.ElmishApp"
             x:Name="m_LogParserToolBarTrayRoot"
             d:DataContext="{d:DesignInstance Type=LogFileModel:IBindings,
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="96"
             d:DesignWidth="1800"
             Background="{StaticResource br_WindiwBackground}"
             mc:Ignorable="d"
             >
    <ToolBarTray x:Name="m_ToolBarTray"
                 VerticalAlignment="Top"
                 Background="{StaticResource br_WindiwBackground}"
                 >
        <ToolBarTray.ContextMenu>
            <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                <MenuItem Click="MenuItem_Click">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="m_KibanaCheckIcon"
                                                     Margin="0,0,5,0"
                                                     IsHitTestVisible="False"
                                                     Kind="Check"
                                                     />
                            <TextBlock VerticalAlignment="Center">Kibana</TextBlock>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </ContextMenu>
        </ToolBarTray.ContextMenu>

        <local:StandardToolBar x:Name="m_StandardToolBar"
                               Band="0"
                               BandIndex="0"
                               RawLogsToggler="{Binding ElementName=m_LogParserToolBarTrayRoot,
                                                        Path=RawLogsToggler}"
                               Style="{StaticResource st_LogParserToolBar}"
                               />
        <local:FiltersToolBar Band="0"
                              BandIndex="1"
                              Style="{StaticResource st_LogParserToolBar}"
                              />
        <local:KibanaSearchToolBar x:Name="m_KibanaSearchToolBar"
                                   Width="1400"
                                   Band="1"
                                   BandIndex="0"
                                   IsEnabled="False"
                                   Style="{StaticResource st_LogParserToolBar}"
                                   Visibility="Collapsed"
                                   />
        <local:KibanaAccountToolBar x:Name="m_KibanaAccountToolBar"
                                    Band="1"
                                    BandIndex="1"
                                    IsEnabled="False"
                                    Style="{StaticResource st_LogParserToolBar}"
                                    Visibility="Collapsed"
                                    />
    </ToolBarTray>
</UserControl>
