<ToolBar x:Class="LogParser.WpfClient.UserControls.ToolBars.StandardToolBar"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:LogFileModel="clr-namespace:LogParser.ElmishApp.LogFileModel;assembly=LogParser.ElmishApp"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:local="clr-namespace:LogParser.WpfClient.UserControls.ToolBars"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         x:Name="m_StandardToolBarRoot"
         d:DataContext="{d:DesignInstance Type=LogFileModel:IBindings,
                                          IsDesignTimeCreatable=False}"
         d:DesignWidth="700"
         d:Style="{StaticResource st_LogParserToolBar}"
         ClipToBounds="True"
         mc:Ignorable="d"
         >
    <Button Command="{Binding PasteFromClipboardCommand}"
            Style="{StaticResource st_ToolBarIconButton}"
            >
        <materialDesign:PackIcon Height="16"
                                 Kind="ContentCopy"
                                 />
    </Button>

    <!--  ClearInputCommand - Command="{Binding ClearInputCommand}"  -->
    <Button Style="{StaticResource st_ToolBarIconButton}">
        <materialDesign:PackIcon Height="20"
                                 Kind="DeleteOutline"
                                 />
    </Button>

    <!--  RawLogsToggler  -->
    <ListBox VerticalAlignment="Center"
             SelectionMode="Extended"
             >
        <ListBoxItem x:Name="m_RawLogsToggler"
                     IsSelected="{Binding ElementName=m_StandardToolBarRoot,
                                          Path=RawLogsToggler}"
                     Style="{DynamicResource st_ToolBarListBoxItem}"
                     >
            <!--  or FileDocumentCheckOutline when document is edited  -->
            <materialDesign:PackIcon Width="18"
                                     Height="18"
                                     Kind="FileDocumentEdit"
                                     />
        </ListBoxItem>
    </ListBox>

    <TextBlock Style="{StaticResource st_ToolBarTextBlock}"
               Text="Tmp Title:"
               />

    <!--  TempTitle - Text="{Binding TempTitle, UpdateSourceTrigger=PropertyChanged}"  -->
    <TextBox Width="120"
             materialDesign:HintAssist.Hint="Temp Title"
             Style="{StaticResource st_ToolBarTextBox}"
             />

    <TextBlock Style="{StaticResource st_ToolBarTextBlock}"
               Text="Log Source Type:"
               />

    <!--  LogSourceType (Kibana or Docker probably) items source - ItemsSource="{Binding LogSourceType}", Text="{Binding LogSourceType, UpdateSourceTrigger=PropertyChanged, Mode=OneWayToSource}"  -->
    <ComboBox Width="130"
              materialDesign:HintAssist.Hint="Log Source Type"
              IsEditable="True"
              IsTextSearchEnabled="True"
              Style="{StaticResource st_ToolBarComboBox}"
              />
</ToolBar>
