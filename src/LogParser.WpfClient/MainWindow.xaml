<Window x:Class="LogParser.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sel="clr-namespace:LogParser.WpfClient.TemplateSelectors"
        xmlns:uc="clr-namespace:LogParser.WpfClient.UserControls"
        xmlns:vm="clr-namespace:LogParser.ElmishApp.Models;assembly=LogParser.ElmishApp"
        Title="{Binding DocumentName}"
        Width="1800"
        d:Height="300"
        AllowDrop="True"
        Background="{StaticResource br_WindiwBackground}"
        Drop="Window_Drop"
        Icon=".\Resources\gnomelogs_103380.ico"
        Style="{StaticResource MaterialDesignWindow}"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        >
    <Window.Resources>
        <sel:LogDataTemplateSelector x:Key="ts_LogDataTemplateSelector" />
        <materialDesign:BooleanToVisibilityConverter x:Key="conv_BoolToVis" />
    </Window.Resources>

    <materialDesign:DialogHost x:Name="m_RootDialogHost"
                               CloseOnClickAway="False"
                               DialogTheme="Inherit"
                               Identifier="RootDialog"
                               SnackbarMessageQueue="{Binding ElementName=m_ErrorMessageQueueSnackbar,
                                                              Path=MessageQueue}"
                               >
        <DockPanel LastChildFill="True">
            <!--  MainMenu  -->
            <DockPanel DockPanel.Dock="Top">
                <!--  Version  -->
                <TextBlock DockPanel.Dock="Right"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource MaterialDesign.Brush.Foreground}"
                           Text="{Binding AssemblyVersion}"
                           />

                <uc:MainMenu DockPanel.Dock="Left"
                             VerticalAlignment="Center"
                             DataContext="{Binding}"
                             />
            </DockPanel>

            <!--  ToolBar  -->
            <uc:LogParserToolBarTray DockPanel.Dock="Top"
                                     DataContext="{Binding}"
                                     />

            <!--  ErrorMessage Snackbar  -->
            <materialDesign:Snackbar x:Name="m_ErrorMessageQueueSnackbar"
                                     DockPanel.Dock="Bottom"
                                     HorizontalAlignment="Stretch"
                                     MessageQueue="{Binding ErrorMessageQueue}"
                                     />

            <!--  Status Bar  -->
            <Border DockPanel.Dock="Bottom"
                    Height="32"
                    Background="{StaticResource br_WindiwBackground}"
                    >
                <TextBlock Margin="10,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                           >
                    <Run Text="Log count:" />
                    <Run Text="{Binding LogCount}" />
                </TextBlock>
            </Border>

            <!--  Content  -->
            <Grid>
                <!--  split view  -->
                <Grid Visibility="{Binding ShowAll, Converter={StaticResource conv_BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition MinWidth="500" />
                    </Grid.ColumnDefinitions>

                    <uc:LogsInput DataContext="{Binding}" />

                    <GridSplitter Grid.Column="1"
                                  Width="4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  Background="{StaticResource br_ToolBarInput}"
                                  />

                    <!--  Logs  -->
                    <uc:LogCardList Grid.Column="2"
                                    DataContext="{Binding}"
                                    />
                </Grid>

                <!--  only log cards view  -->
                <uc:LogCardList DataContext="{Binding}"
                                Visibility="{Binding ShowOnlyParsedLogs,
                                                     Converter={StaticResource conv_BoolToVis}}"
                                />
            </Grid>
        </DockPanel>
    </materialDesign:DialogHost>
</Window>
