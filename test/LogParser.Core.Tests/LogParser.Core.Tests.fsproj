<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Utilities\ShouldExtensions.fs" />
    <Compile Include="Utilities\MockLoggerFactory.fs" />
    <Compile Include="Types\TechJsonLogFieldTests.fs" />
    <Compile Include="LogParserTests\ParserTests.PrimitiveFieldCases.fs" />
    <Compile Include="LogParserTests\ParserTests.SpecialFieldCases.fs" />
    <Compile Include="LogParserTests\ParserTests.ArrayFieldCases.fs" />
    <Compile Include="LogParserTests\ParserTests.ArrayJsonAnnonimousCases.fs" />
    <Compile Include="LogParserTests\ParserTests.ArrayJsonCases.fs" />
    <Compile Include="LogParserTests\ParserTests.ArrayJsonAnnotatedCases.fs" />
    <Compile Include="LogParserTests\ParserTests.JsonFieldCases.fs" />
    <Compile Include="LogParserTests\ParserTests.JsonAnnotatedValueCases.fs" />
    <Compile Include="LogParserTests\ParserTests.JsonAnnotatedCases.fs" />
    <Compile Include="LogParserTests\ParserTests.BodyCases.fs" />
    <Compile Include="LogParserTests\ParserTests.MessageJsonListCases.fs" />
    <Compile Include="LogParserTests\ParserTests.MessageStringCases.fs" />
    <Compile Include="LogParserTests\ParserTests.MessageCases.fs" />
    <Compile Include="LogParserTests\ParserTests.MessageBodiedCases.fs" />
    <Compile Include="LogParserTests\ParserTests.MessageBodiedWithPostfixCases.fs" />
