<UserControl x:Class="LogParser.WpfClient.UserControls.RawLogsInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LogParser.WpfClient.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d"
             >
    <StackPanel Orientation="Vertical">
        <Label FontSize="10" Foreground="#888888">Log Text:</Label>
        <TextBox MinWidth="280"
                 Margin="5,0,5,5"
                 Padding="10"
                 VerticalAlignment="Stretch"
                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                 materialDesign:TextFieldAssist.TextBoxIsMultiLine="True"
                 AcceptsReturn="True"
                 AllowDrop="true"
                 Background="#1E1E1E"
                 BorderThickness="0"
                 Foreground="#E6E6E6"
                 PreviewDragOver="TextBox_PreviewDragOver"
                 PreviewDrop="Window_Drop"
                 Style="{StaticResource MaterialDesignTextBox}"
                 TextAlignment="Left"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 />
        <Button Margin="0,3,5,0"
                HorizontalAlignment="Right"
                Content="Parse"
                Style="{StaticResource MaterialDesignPaperDarkButton}"
                />
    </StackPanel>
</UserControl>
