<UserControl x:Class="LogParser.WpfClient.UserControls.MainMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LogParser.WpfClient.UserControls"
             xmlns:mainModel="clr-namespace:LogParser.ElmishApp.MainModel;assembly=LogParser.ElmishApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=mainModel:IBindings,
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="34"
             d:DesignWidth="500"
             mc:Ignorable="d"
             >
    <DockPanel DockPanel.Dock="Top">
        <!--  Version  -->
        <TextBlock DockPanel.Dock="Right"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="{StaticResource MaterialDesign.Brush.Foreground}"
                   Text="{Binding AssemblyVersion}"
                   />

        <local:MainMenu DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        DataContext="{Binding}"
                        />
    </DockPanel>
</UserControl>
