<ToolBar x:Class="LogParser.WpfClient.UserControls.ToolBars.FiltersToolBar"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:local="clr-namespace:LogParser.WpfClient.UserControls.ToolBars"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         d:DesignWidth="1350"
         Style="{StaticResource st_LogParserToolBar}"
         mc:Ignorable="d"
         >
    <!--  Log filters  -->
    <ListBox VerticalAlignment="Center"
             SelectionMode="Extended"
             >
        <ListBoxItem IsSelected="{Binding FilterOn}"
                     Style="{DynamicResource st_ToolBarListBoxItem}"
                     ToolTip="Enable filtering by TraceId"
                     >
            <materialDesign:PackIcon Height="18"
                                     Kind="Filter"
                                     />
        </ListBoxItem>
        <ListBoxItem IsSelected="{Binding ShowInnerHierarchyLogs}"
                     Style="{DynamicResource st_ToolBarListBoxItem}"
                     ToolTip="When disabled only root logs are shown"
                     >
            <materialDesign:PackIcon Height="18"
                                     Kind="FileTree"
                                     />
        </ListBoxItem>
    </ListBox>

    <ToggleButton Padding="10,0"
                  Command="{Binding DataContext.OrderByTimestampCommand,
                                    RelativeSource={RelativeSource Mode=FindAncestor,
                                                                   AncestorType=Window}}"
                  Style="{StaticResource st_ToolBarIconToggleButton}"
                  >
        <materialDesign:PackIcon Height="22"
                                 Kind="SortClockAscendingOutline"
                                 />
    </ToggleButton>

    <TextBlock Style="{StaticResource st_ToolBarTextBlock}"
               Text="From:  "
               />

    <local:ToolBarDateTimePicker DateTime="{Binding Start}" />

    <TextBlock Style="{StaticResource st_ToolBarTextBlock}"
               Text="To:  "
               />

    <local:ToolBarDateTimePicker VerticalAlignment="Center"
                                 DateTime="{Binding End}"
                                 />

    <!--  Log Levels  -->
    <ComboBox materialDesign:HintAssist.Hint="Log Level"
              IsEditable="True"
              IsTextSearchEnabled="True"
              ItemsSource="{Binding LogLevels}"
              Style="{StaticResource st_ToolBarComboBox}"
              Text="{Binding SelectedLogLevel,
                             UpdateSourceTrigger=PropertyChanged,
                             Mode=OneWayToSource}"
              />

    <!--  Service name  -->
    <ComboBox materialDesign:HintAssist.Hint="Service name"
              IsEditable="True"
              IsTextSearchEnabled="True"
              ItemsSource="{Binding ServiceNames}"
              Style="{StaticResource st_ToolBarComboBox}"
              Text="{Binding SelectedServiceName,
                             UpdateSourceTrigger=PropertyChanged,
                             Mode=OneWayToSource}"
              />


</ToolBar>
